# Environment configuration example for VibeMiles
# Duplicate this file as .env and provide your local credentials.
# NEVER commit real credentials or secrets to version control.

# PostgreSQL Connection URL (Connection pooler for Prisma Client)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct PostgreSQL Connection URL (Direct connection for Prisma Migrations)
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Environment
NODE_ENV="development"

# Authentication Secret (Used for signing secure session cookies and JWTs)
AUTH_SECRET="your-32-byte-secret-hex-or-string"
