# Environment configuration example for VibeMiles
# Duplicate this file as .env and provide your local credentials.
# NEVER commit real credentials or secrets to version control.

# PostgreSQL Connection URL (Connection pooler for Prisma Client)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct PostgreSQL Connection URL (Direct connection for Prisma Migrations)
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Environment
NODE_ENV="development"

# Authentication Secret (Used for signing secure session cookies and JWTs)
AUTH_SECRET="your-32-byte-secret-hex-or-string"

# Base Application URL (Used for QR codes, email notifications, and webhook callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Razorpay Payment Gateway Integration ───────────────────────────
# All customer payments settle directly to the VibeMiles merchant bank account registered with Razorpay.
# Provider payouts are tracked in the Settlement Ledger and executed separately by Admin.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Razorpay Webhook Secret (Set up in Razorpay Dashboard > Settings > Webhooks)
# Webhook URL: https://yourdomain.com/api/webhooks/razorpay
# Events to subscribe: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ─── Marketplace Financial Configuration ───────────────────────────
# Standard platform commission deducted from gross booking amount (default 15.0%)
PLATFORM_COMMISSION_PERCENT="15.0"
